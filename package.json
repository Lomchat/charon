{
  "name": "charon",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted hub and remote workspace for Claude Code and OpenAI Codex sessions across a VPS fleet.",
  "license": "Apache-2.0",
  "author": "Lomchat",
  "homepage": "https://github.com/Lomchat/charon#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lomchat/charon.git"
  },
  "bugs": {
    "url": "https://github.com/Lomchat/charon/issues"
  },
  "keywords": [
    "claude",
    "claude-code",
    "claude-agent-sdk",
    "anthropic",
    "codex",
    "openai",
    "mcp",
    "remote-ide",
    "ssh",
    "vps",
    "nextjs",
    "self-hosted",
    "agent",
    "dashboard"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node server.js",
    "build": "node scripts/check-protocol-sync.mjs && next build && node scripts/migrate.mjs && touch .next/.deploy-ready",
    "start": "node server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "test:watch": "vitest",
    "test:py": "sh -c 'PY=$(command -v python3.13 || command -v python3.12 || command -v python3.11 || command -v python3.10 || command -v python3); \"$PY\" -m unittest discover -s agent/tests -v'",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node ./scripts/migrate.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@types/ws": "^8.18.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^11.8.1",
    "codemirror": "^6.0.2",
    "diff": "^9.0.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "next": "^16.2.12",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "web-push": "^3.6.7",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/diff": "^7.0.2",
    "@types/node": "^22.10.6",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.3",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.7.3",
    "vitest": "^3.2.6"
  },
  "overrides": {
    "postcss": "^8.5.18",
    "sharp": "^0.35.3"
  }
}
