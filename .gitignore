node_modules
.next
build
tsconfig.tsbuildinfo
data/*
!data/.gitkeep
.env
.env.*
!.env.example

# Local docker artifacts: ./docker/ssh is the runtime SSH material bind-mounted
# into the container (private key + charon_known_hosts). NEVER commit its
# contents — but the DIRECTORY itself must exist in a fresh clone, hence the
# tracked .gitkeep: a bind mount whose source is missing is materialised by
# Docker as an empty directory, which would then shadow the key path.
docker/ssh/*
!docker/ssh/.gitkeep

# Python artifacts (agent/charon_agent/)
__pycache__/
*.pyc
*.pyo

# Claude Code local working dir (worktrees, settings) — not committed
.claude/

# Internal/private dev docs (not for the public repo)
todo.md
CLAUDE.md
# AGENTS.md is a local symlink -> CLAUDE.md. It MUST stay untracked: committing
# the symlink ships a DANGLING link (CLAUDE.md is ignored above), and `next
# build` stat()s the repo root -> ENOENT -> CI build failure. See §14.63.
AGENTS.md
